{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yuki",
  "version": "1.1.0",
  "identifier": "com.genzo.android",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Yuki",
        "width": 390,
        "height": 844,
        "resizable": true,
        "dragDropEnabled": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://lain.bgm.tv https://image.tmdb.org https://s4.anilist.co https://*.mangafunb.fun blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$LOCALAPPDATA/**",
          "$PICTURE/**",
          "$DOCUMENT/**",
          "$DOWNLOAD/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "Entertainment",
    "shortDescription": "安卓动漫、漫画与轻小说媒体库",
    "longDescription": "Yuki 将动漫观看、漫画阅读、轻小说与个人记录整合在安卓设备中。",
    "publisher": "Yuki contributors",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 26
    }
  }
}
